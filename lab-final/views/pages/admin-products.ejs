<!DOCTYPE html>
<html lang="en">
<head>
  <%- include("../partials/head", { title }) %>
</head>
<body>

<%- include("../partials/header") %>

<section class="admin-container">
  <div class="admin-header">
    <h1>Admin Products</h1>
    <button class="btn-primary" id="openCreate">+ Create Product</button>
  <a href="/admin/orders"><button class="btn-secondary">Show Orders</button></a>
  </div>

  <div id="alertBox"></div>

  <div class="products-grid" id="productsGrid"></div>
</section>

<!-- Orders Section -->
<section id="ordersSection" style="display:none; margin-top: 2rem;">
  <h2>Admin Orders Dashboard</h2>
  <table border="1" cellpadding="5" cellspacing="0" id="ordersTable">
    <thead>
      <tr>
        <th>Order ID</th>
        <th>Customer</th>
        <th>Total Amount</th>
        <th>Status</th>
        <th>Order Date</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="ordersBody"></tbody>
  </table>
</section>

<!-- MODAL -->
<div class="modal-overlay" id="modalOverlay">
  <div class="modal-box">
    <h2 id="modalTitle">Create Product</h2>

    <form id="productForm">
      <input type="hidden" id="productId">

      <input type="text" id="name" placeholder="Product Name" required>
      <input type="number" id="price" placeholder="Price" required>
      <input type="text" id="imageUrl" placeholder="Image URL">
      <input type="text" id="category" placeholder="Category (e.g. Drinks, Cocktails)" required>

      <textarea id="description" placeholder="Description"></textarea>

      <div class="modal-actions">
        <button type="button" class="btn-secondary" id="closeModal">Cancel</button>
        <button type="submit" class="btn-primary">Save</button>
      </div>
    </form>
  </div>
</div>

<script>
const grid = document.getElementById("productsGrid");
const modal = document.getElementById("modalOverlay");
const modalTitle = document.getElementById("modalTitle");

const productId = document.getElementById("productId");
const nameInput = document.getElementById("name");
const priceInput = document.getElementById("price");
const imageInput = document.getElementById("imageUrl");
const descInput = document.getElementById("description");
const categoryInput = document.getElementById("category");

document.getElementById("openCreate").onclick = () => openCreate();
document.getElementById("closeModal").onclick = () => closeModal();

function showAlert(type, msg) {
  document.getElementById("alertBox").innerHTML =
    `<div class="alert ${type}">${msg}</div>`;
}

function openCreate() {
  modalTitle.textContent = "Create Product";
  productId.value = "";
  nameInput.value = "";
  priceInput.value = "";
  imageInput.value = "";
  descInput.value = "";
  categoryInput.value = "";

  modal.classList.add("show");
}

function openEdit(p) {
  modalTitle.textContent = "Edit Product";
  productId.value = p._id;
  nameInput.value = p.name;
  priceInput.value = p.price;
  imageInput.value = p.imageUrl || "";
  descInput.value = p.description || "";
  categoryInput.value = p.category || "";

  modal.classList.add("show");
}

function closeModal() {
  modal.classList.remove("show");
}

async function fetchProducts() {
  const res = await fetch("/api/products");
  const json = await res.json();
  return json.data || [];
}

function render(products) {
  if (!products.length) {
    grid.innerHTML = `<p>No products found.</p>`;
    return;
  }

  grid.innerHTML = products.map(p => `
    <div class="product-card">
      <img src="${p.imageUrl || '/assets/placeholder.png'}">
      <div class="card-body">
        <h3>${p.name}</h3>
          <span class="category">${p.category || "Uncategorized"}</span>

        <p>${p.description || ""}</p>
        <span class="price">PKR ${p.price}</span>

        <div class="card-actions">
          <button class="btn-edit" onclick='openEdit(${JSON.stringify(p)})'>Edit</button>
          <button class="btn-delete" onclick="removeProduct('${p._id}')">Delete</button>
        </div>
      </div>
    </div>
  `).join("");
}

async function removeProduct(id) {
  if (!confirm("Delete this product?")) return;
  await fetch(`/api/products/${id}`, { method: "DELETE" });
  load();
}

document.getElementById("productForm").onsubmit = async e => {
  e.preventDefault();

  const payload = {
  name: nameInput.value,
  price: Number(priceInput.value),
  imageUrl: imageInput.value,
  description: descInput.value,
  category: categoryInput.value
};

  const id = productId.value;
  await fetch(id ? `/api/products/${id}` : "/api/products", {
    method: id ? "PUT" : "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload)
  });

  closeModal();
  load();
};

async function load() {
  render(await fetchProducts());
}

load();

// --------------------- Show Orders Feature ---------------------

const showOrdersBtn = document.getElementById("showOrdersBtn");
const ordersSection = document.getElementById("ordersSection");
const ordersBody = document.getElementById("ordersBody");

showOrdersBtn.onclick = async () => {
  // Toggle visibility
  ordersSection.style.display = ordersSection.style.display === "none" ? "block" : "none";

  if (ordersSection.style.display === "block") {
    // Fetch orders from admin-only route
    const res = await fetch("/admin/orders?email=admin@shop.com"); // adminOnly middleware needs email
    const orders = await res.json(); // JSON response of orders

    // Render orders in table
    ordersBody.innerHTML = orders.map(order => `
      <tr>
        <td>${order._id}</td>
        <td>${order.customerName}</td>
        <td>PKR ${order.totalAmount}</td>
        <td>${order.status}</td>
        <td>${new Date(order.createdAt).toLocaleString()}</td>
        <td>
          ${order.status !== 'Confirmed' ? `<button onclick="updateOrderStatus('${order._id}','Confirmed')">Confirm</button>` : ''}
          ${order.status !== 'Cancelled' ? `<button onclick="updateOrderStatus('${order._id}','Cancelled')">Cancel</button>` : ''}
        </td>
      </tr>
    `).join("");
  }
};

async function updateOrderStatus(id, status) {
  await fetch(`/admin/orders/${id}/status`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ status, email: "admin@shop.com" }) // email needed for adminOnly middleware
  });

  // Refresh orders after update
  showOrdersBtn.click(); // hide
  showOrdersBtn.click(); // show & reload
}
</script>

<%- include("../partials/footer") %>
</body>
</html>
